# Server-only settings. Never prefix AWS credentials with NEXT_PUBLIC_.
# Copy this to .env.local; choose a model your AWS account can actually invoke.
AWS_REGION=
AWS_BEDROCK_MODEL_ID=
# Optional if your SDK credentials use a named local profile:
# AWS_PROFILE=
# Enable AI for fictional demo data (works locally or on the configured deployment):
LOCAL_DEMO_AI_ENABLED=false

# Prefer an existing local AWS profile / IAM Identity Center credentials.
# Do not paste access keys into chat or commit credentials.

# Legacy Amazon SNS settings (current SMS provider is PhilSMS).
AWS_SMS_SENDER_ID=
AWS_SMS_ALLOWED_NUMBERS=
LOCAL_DEMO_SMS_ENABLED=false

# Supabase server credentials (never NEXT_PUBLIC_ for secret keys)
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# SUPABASE_SERVICE_ROLE_KEY= (legacy alternative)
# Optional region overrides
AWS_SNS_REGION=
AWS_BEDROCK_REGION=
# Optional static server credentials; use a profile instead if already configured.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=

# PhilSMS server-only settings; never use NEXT_PUBLIC_.
PHILSMS_API_TOKEN=
PHILSMS_SENDER_ID=PhilSMS
# SMS uses each patient record's saved +639XXXXXXXXX number.
# SMS_ALLOWED_NUMBERS / AWS_SMS_ALLOWED_NUMBERS are no longer used.
# Set existing LOCAL_DEMO_SMS_ENABLED=true when ready to send.

# Deployed fictional demo: exact HTTPS origin (e.g. https://your-app.vercel.app).
APP_ORIGIN=


# Vercel deployment URLs are detected from system environment variables.
# APP_ORIGIN is optional for Vercel URLs; set it for an additional custom domain.
# Add the Supabase, AWS and PhilSMS settings in Vercel,
# then redeploy. Local .env.local is not uploaded to Vercel.

# Real staff login: shared DEMO_ACCESS_PASSWORD is no longer used.
# Optional preferred key for Auth; server secret remains server-only for DB access.
SUPABASE_PUBLISHABLE_KEY=

# Compatibility with existing Bedrock apps (server-only aliases):
# BEDROCK_MODEL_ID=your-existing-model-or-inference-profile-id
# BEDROCK_REGION=ap-southeast-1
# BEDROCK_AI_ENABLED=true
# Canonical AWS_BEDROCK_MODEL_ID / AWS_BEDROCK_REGION take precedence.
