# Server-only settings. Never prefix AWS credentials with NEXT_PUBLIC_.
# Copy this to .env.local; choose a model your AWS account can actually invoke.
AWS_REGION=
AWS_BEDROCK_MODEL_ID=
# Optional if your SDK credentials use a named local profile:
# AWS_PROFILE=
# Deliberate enablement for this localhost-only, fictional-data demo:
LOCAL_DEMO_AI_ENABLED=false

# Prefer an existing local AWS profile / IAM Identity Center credentials.
# Do not paste access keys into chat or commit credentials.

# Optional Amazon SNS SMS; disabled until setup and recipient consent.
AWS_SMS_SENDER_ID=
AWS_SMS_ALLOWED_NUMBERS=
LOCAL_DEMO_SMS_ENABLED=false

# Supabase server credentials (never NEXT_PUBLIC_ for secret keys)
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# SUPABASE_SERVICE_ROLE_KEY= (legacy alternative)
# Optional region overrides
AWS_SNS_REGION=
AWS_BEDROCK_REGION=
# Optional static server credentials; use a profile instead if already configured.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=

# PhilSMS server-only settings; never use NEXT_PUBLIC_.
PHILSMS_API_TOKEN=
PHILSMS_SENDER_ID=PhilSMS
# Comma-separated consented demo recipients in +639XXXXXXXXX format.
SMS_ALLOWED_NUMBERS=
# Set existing LOCAL_DEMO_SMS_ENABLED=true when ready to send.
